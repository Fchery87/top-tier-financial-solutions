{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    ">0.3%",
    "not dead",
    "not op_mini all",
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "iOS >= 14",
    "Android >= 8"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "node -e \"require('fs').rmSync('.next/dev',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads --maxWorkers=4 --exclude=src/__tests__/api/admin/dispute-submission-tracking.test.ts --exclude=src/components/workspace/__tests__/AdminAnalyticsPanel.test.tsx --exclude=src/lib/parsers/__tests__/pdf-text-extraction.test.ts --shard=1/2 && vitest run --pool=threads --maxWorkers=4 --exclude=src/__tests__/api/admin/dispute-submission-tracking.test.ts --exclude=src/components/workspace/__tests__/AdminAnalyticsPanel.test.tsx --exclude=src/lib/parsers/__tests__/pdf-text-extraction.test.ts --shard=2/2 && vitest run --pool=threads --maxWorkers=1 src/__tests__/api/admin/dispute-submission-tracking.test.ts src/components/workspace/__tests__/AdminAnalyticsPanel.test.tsx && vitest run --pool=forks src/lib/parsers/__tests__/pdf-text-extraction.test.ts",
    "test:fast": "node scripts/test-fast-lane.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:repair-migrations": "node scripts/repair-drizzle-migrations.mjs",
    "db:audit-deprecated-letter-table": "tsx scripts/audit-deprecated-letter-templates.ts",
    "db:pilot-letter-library": "tsx scripts/run-letter-library-pilot.ts",
    "security:rotate-encryption": "tsx scripts/rotate-encryption-keys.ts",
    "security:reset-mfa": "tsx scripts/reset-mfa.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@aws-sdk/client-s3": "^3.1178.0",
