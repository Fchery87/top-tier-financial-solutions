    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^11.19.0",
    "@tanstack/react-query": "^5.108.4",
    "@upstash/ratelimit": "^2.2.3",
    "@upstash/redis": "^1.41.1",
    "better-auth": "^1.7.28",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^12.23.24",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.555.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "openai": "^6.18.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.4.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.11.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.6"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.1"
    },
    "minimatch@3": {
      "brace-expansion": "^1.1.13"
    },
    "eslint-plugin-react-hooks": "7.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.7",
